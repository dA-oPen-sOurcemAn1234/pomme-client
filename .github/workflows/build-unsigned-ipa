name: Build Pomme iOS

# Builds an UNSIGNED Pomme.ipa for sideloading (AltStore, Sideloadly), which
# re-sign it with your own Apple ID. Replaces the old build-ios.yml, which
# zipped the bare binary (no .app bundle, Info.plist, MoltenVK or OpenAL), so
# the result could not be installed.
#
# Run it from the Actions tab (Run workflow), or push a tag like ios-v0.1.0 to
# also attach the IPA to a GitHub release.

on:
  workflow_dispatch:
  push:
    tags:
      - "ios-v*"

permissions:
  contents: write # only used to attach the IPA to a release on tag pushes

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
  HOMEBREW_NO_AUTO_UPDATE: 1
  HOMEBREW_NO_INSTALL_CLEANUP: 1

jobs:
  ipa:
    runs-on: macos-15
    timeout-minutes: 150
    steps:
      # SteelMC is excluded from the workspace but still resolved by path.
      - uses: actions/checkout@v7
        with:
          submodules: recursive

      - name: Install xcodegen and cmake
        run: brew install xcodegen cmake

      # rust-toolchain.toml pins the nightly; install exactly that one.
      - name: Install the pinned Rust toolchain and the iOS target
        run: |
          rustup show active-toolchain || rustup toolchain install --profile minimal
          rustup target add aarch64-apple-ios
          rustc --version

      # Same pinned action and version as .github/actions/setup-rust. It sets
      # VULKAN_SDK, which build-app.sh uses for the host-built shaderc (the
      # app itself links MoltenVK instead).
      - name: Install Vulkan SDK
        uses: jakoch/install-vulkan-sdk-action@37effcfa045411f8bfbbda26df2fd1b3bf3436fa
        with:
          vulkan_version: 1.4.341.0
          install_runtime: false
          cache: true
          stripdown: true

      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ios-ipa
          cache-on-failure: true

      # MoltenVK and the OpenAL Soft source/build tree live in target/ outside
      # cargo's own output. Declared after rust-cache so this saves first.
      - uses: actions/cache@v4
        with:
          path: |
            target/moltenvk
            target/openal-soft
          key: ios-tools-${{ runner.os }}-${{ hashFiles('tools/fetch_moltenvk.py', 'tools/build_openal.py', 'tools/fetch_openal.py', 'pomme-client/third-party/openal-natives.txt') }}

      - name: Generate the Xcode project
        working-directory: pomme-ios
        run: xcodegen generate --quiet

      # Release, so the Rust client is optimized. With signing off,
      # EXPANDED_CODE_SIGN_IDENTITY is empty and build-app.sh skips codesigning
      # soft_oal.framework.
      - name: Build Pomme.app (unsigned)
        run: |
          set -o pipefail
          xcodebuild \
            -project pomme-ios/Pomme.xcodeproj \
            -scheme Pomme \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath target/ios-build \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            DEVELOPMENT_TEAM="" \
            build

      - name: Package Pomme.ipa
        run: |
          app="target/ios-build/Build/Products/Release-iphoneos/Pomme.app"
          if [ ! -d "$app" ]; then
            echo "::error::$app was not produced"
            find target/ios-build/Build/Products -maxdepth 2 || true
            exit 1
          fi
          file "$app/Pomme"
          plutil -p "$app/Info.plist" | grep -E 'CFBundleIdentifier|MinimumOSVersion|CFBundleExecutable'
          ls -la "$app/Frameworks"
          rm -rf ipa
          mkdir -p ipa/Payload
          cp -R "$app" ipa/Payload/
          (cd ipa && zip -qry Pomme.ipa Payload)
          unzip -l ipa/Pomme.ipa | head -20
          ls -lh ipa/Pomme.ipa

      # The IPA is already a zip, so skip recompression. GitHub still wraps
      # it in a zip when you download it: unzip once to get Pomme.ipa.
      - uses: actions/upload-artifact@v4
        with:
          name: Pomme-unsigned-ipa
          path: ipa/Pomme.ipa
          if-no-files-found: error
          retention-days: 14
          compression-level: 0

      # Tag pushes (ios-v*) also publish the IPA on a release.
      - name: Attach IPA to the release
        if: startsWith(github.ref, 'refs/tags/ios-v')
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          if gh release view "$TAG" >/dev/null 2>&1; then
            gh release upload "$TAG" ipa/Pomme.ipa --clobber
          else
            gh release create "$TAG" ipa/Pomme.ipa --title "Pomme iOS $TAG" \
              --notes "Unsigned IPA for sideloading (AltStore, Sideloadly)." --prerelease
          fi
